import java.util.Scanner;

public class ModularCalculator {

    // ------------------ Calculation Methods ------------------
    // Each method takes parameters and returns result; NO print statements here

    public static double add(double num1, double num2) {
        return num1 + num2;
    }

    public static double subtract(double num1, double num2) {
        return num1 - num2;
    }

    public static double multiply(double num1, double num2) {
        return num1 * num2;
    }

    public static double divide(double num1, double num2) {
        if (num2 == 0) {
            return Double.NaN; // Return "Not a Number" for division by zero
        }
        return num1 / num2;
    }


    // ------------------ Main Menu & Logic ------------------
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int choice;
        double num1, num2, result;

        do {
            // Display menu
            System.out.println("\n===== MODULAR CALCULATOR =====");
            System.out.println("1. Addition");
            System.out.println("2. Subtraction");
            System.out.println("3. Multiplication");
            System.out.println("4. Division");
            System.out.println("5. Exit");
            System.out.print("Enter your choice (1-5): ");

            // Validate menu input
            while (!input.hasNextInt()) {
                System.out.print("Invalid input! Enter a number: ");
                input.next();
            }
            choice = input.nextInt();

            if (choice >= 1 && choice <= 4) {
                // Get numbers from user
                System.out.print("Enter first number: ");
                while (!input.hasNextDouble()) {
                    System.out.print("Invalid number! Try again: ");
                    input.next();
                }
                num1 = input.nextDouble();

                System.out.print("Enter second number: ");
                while (!input.hasNextDouble()) {
                    System.out.print("Invalid number! Try again: ");
                    input.next();
                }
                num2 = input.nextDouble();

                // Call appropriate function and store result
                switch (choice) {
                    case 1:
                        result = add(num1, num2);
                        System.out.printf("Result: %.2f + %.2f = %.2f%n", num1, num2, result);
                        break;
                    case 2:
                        result = subtract(num1, num2);
                        System.out.printf("Result: %.2f - %.2f = %.2f%n", num1, num2, result);
                        break;
                    case 3:
                        result = multiply(num1, num2);
                        System.out.printf("Result: %.2f × %.2f = %.2f%n", num1, num2, result);
                        break;
                    case 4:
                        result = divide(num1, num2);
                        if (Double.isNaN(result)) {
                            System.out.println("Error: Cannot divide by zero!");
                        } else {
                            System.out.printf("Result: %.2f ÷ %.2f = %.2f%n", num1, num2, result);
                        }
                        break;
                }
            } else if (choice != 5) {
                System.out.println("Invalid choice! Please select 1-5.");
            }

        } while (choice != 5);

        System.out.println("Calculator closed. Goodbye!");
        input.close();
    }
}



